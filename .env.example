# Copy this file to .env and fill in real values.
# NEVER commit .env. Only this example file belongs in Git.

# ---------- App ----------
APP_ENV=development
APP_NAME=ConnectSphere

# ---------- PostgreSQL (Docker) ----------
# Host port is 5433 because a local PostgreSQL 18 service already uses 5432 on this machine.
POSTGRES_USER=connectsphere
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=connectsphere
POSTGRES_HOST_PORT=5433

# Used by the backend. Inside Docker the host is "db" and the port is 5432.
# From your machine (outside Docker) use localhost:5433.
DATABASE_URL=postgresql+psycopg://connectsphere:change-me-local-only@localhost:5433/connectsphere

# ---------- Security ----------
# Generate with:  py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# ---------- Frontend ----------
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# ---------- Media storage ----------
# "local" saves uploads to disk in development. "s3" is planned for deployment.
MEDIA_STORAGE=local
MEDIA_ROOT=./media
