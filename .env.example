# Copy this file to .env and fill in real values.
# NEVER commit .env. Only this example file belongs in Git.

# ---------- App ----------
APP_ENV=development
APP_NAME=ConnectSphere

# ---------- PostgreSQL (Docker) ----------
# Host port is 5433 because a local PostgreSQL 18 service already uses 5432 on this machine.
POSTGRES_USER=connectsphere
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=connectsphere
POSTGRES_HOST_PORT=5433

# Used by the backend (async driver: asyncpg).
# The backend runs on your machine, so it connects to localhost:5433.
# Password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+asyncpg://connectsphere:change-me-local-only@localhost:5433/connectsphere

# ---------- Security ----------
# Generate with:  py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# ---------- Media storage ----------
# "local" saves uploads to disk in development. "s3" is planned for deployment.
MEDIA_STORAGE=local
MEDIA_ROOT=./media
